// prisma/schema.prisma
// Moolah Minds — Single source of truth for the database schema
// Week 1-3 scope: Users, Auth, Profiles, Cohorts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums removed for SQLite compatibility - handled as Strings in application logic

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profiles     Profile[]

  @@map("users")
}

// ─── Cohorts ─────────────────────────────────────────────────────────────────

model Cohort {
  id         String     @id @default(uuid())
  // ISO year + week number: e.g. "2025-W03"
  // All users registering in the same calendar week belong to the same cohort
  weekKey    String     @unique
  startedAt  DateTime   @default(now())

  profiles   Profile[]

  @@map("cohorts")
}

// ─── Profiles ────────────────────────────────────────────────────────────────

model Profile {
  id         String     @id @default(uuid())
  userId     String
  cohortId   String
  name       String
  difficulty String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort     Cohort     @relation(fields: [cohortId], references: [id])

  // Populated in later milestones
  gameState  GameState?
  transactions Transaction[]
  obligations  Obligation[]
  investments  Investment[]
  decisions    Decision[]
  events       GameEvent[]
  weeklySummaries WeeklySummary[]

  @@map("profiles")
}

// ─── Game State ───────────────────────────────────────────────────────────────
// Scaffolded here; fully implemented in Milestone 4

model GameState {
  id          String     @id @default(uuid())
  profileId   String     @unique
  currentWeek Int        @default(1)
  salary      Int        // stored in paise/cents to avoid floating point
  creditScore Int        @default(700)
  socialScore Int        @default(50)
  wellBeing   Int        @default(75)
  status      String     @default("ACTIVE")
  updatedAt   DateTime   @updatedAt

  profile     Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("game_states")
}

// ─── Transactions (Immutable Ledger) ─────────────────────────────────────────
// RULE: balance is NEVER stored as a column — always derived via SUM(amount)

model Transaction {
  id          String   @id @default(uuid())
  profileId   String
  type        String
  category    String   // e.g. 'rent', 'insurance', 'stocks', 'salary'
  amount      Int      // positive = credit, negative = debit (in paise/cents)
  gameWeek    Int
  description String
  metadata    String?  // JSON string: flexible field for extra context (event details, asset info)
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, gameWeek])
  @@map("transactions")
}

// ─── Obligations ─────────────────────────────────────────────────────────────

model Obligation {
  id          String   @id @default(uuid())
  profileId   String
  label       String   // e.g. 'Rent', 'Health Insurance', 'Car EMI'
  category    String
  amount      Int      // amount deducted per week (in paise/cents)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("obligations")
}

// ─── Investments ─────────────────────────────────────────────────────────────

model Investment {
  id           String   @id @default(uuid())
  profileId    String
  productCode  String   // e.g. 'FD_6M', 'NIFTY_MF', 'STOCK_TECH'
  type         String   // 'FD' | 'MUTUAL_FUND' | 'STOCK'
  principalAmount Int
  currentValue Int
  purchasedAtWeek Int
  maturityWeek Int?     // null for open-ended products
  isActive     Boolean  @default(true)
  metadata     String?  // JSON string
  createdAt    DateTime @default(now())

  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("investments")
}

// ─── Decisions ───────────────────────────────────────────────────────────────

model Decision {
  id          String   @id @default(uuid())
  profileId   String
  gameWeek    Int
  type        String   // 'PURCHASE' | 'INVEST' | 'SELF_INVEST' | 'REDEEM'
  category    String
  amount      Int
  metadata    String?  // JSON string
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, gameWeek])
  @@map("decisions")
}

// ─── Game Events ─────────────────────────────────────────────────────────────

model GameEvent {
  id          String   @id @default(uuid())
  profileId   String
  gameWeek    Int
  eventCode   String   // e.g. 'HEALTH_EMERGENCY', 'MARKET_CRASH'
  category    String   // 'CAREER' | 'HEALTH' | 'MARKET' | 'SOCIAL'
  description String
  effects     String   // JSON string: { creditScoreDelta, wellBeingDelta, extraExpense, etc. }
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, gameWeek])
  @@map("game_events")
}

// ─── Weekly Summaries ─────────────────────────────────────────────────────────

model WeeklySummary {
  id              String   @id @default(uuid())
  profileId       String
  gameWeek        Int
  beforeMetrics   String   // JSON string: snapshot of metrics at start of week
  afterMetrics    String   // JSON string: snapshot of metrics at end of week
  eventsTriggered String   // JSON string: array of event codes that fired
  explanations    String   // JSON string: human-readable causal strings array
  createdAt       DateTime @default(now())

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, gameWeek])
  @@map("weekly_summaries")
}
